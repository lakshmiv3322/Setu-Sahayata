# Supabase Project URL (Get from: Supabase Dashboard -> Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public Key (Get from: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Gemini API Key (Get from: Google AI Studio -> https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
